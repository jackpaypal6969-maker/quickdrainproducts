# Quick Drain Products — every variable the app reads. Copy to .env and fill.
# Never commit .env. Names only in this file.

# --- identity / paths (no absolute path may live in code; they live here) ---
APP_NAME=Quick Drain Products
ENV=production
APP_DIR=
DB_PATH=
MEDIA_DIR=
BACKUP_DIR=
# Off-server copy target for backup.sh: an rclone remote:path or user@host:/path (scp). Empty = local only.
BACKUP_REMOTE=
BASE_URL=
SERVER_NAME=
PORT=8006
PUBLIC_PORT=8086
WORKERS=2
LOG_LEVEL=info
TZ=America/New_York
# systemd user that runs the app (deploy.sh creates it if missing)
SERVICE_USER=quickdrain
# Tailwind CLI version pinned by build_css.sh
TAILWIND_VERSION=4.3.3

# --- sessions / cookies ---
SECRET_KEY=
COOKIE_SECURE=off
SESSION_DAYS=30

# --- admin ---
ADMIN_BASIC_AUTH_USER=
ADMIN_BASIC_AUTH_PASSWORD=
ADMIN_ALLOW_IPS=
ADMIN_2FA_REQUIRED=on

# --- Stripe (TEST keys until told otherwise) ---
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_TAX_ENABLED=on
SUBSCRIPTIONS_ENABLED=on
# Live keys are refused unless this is on. Leave off until told otherwise.
STRIPE_LIVE_OK=off

# --- shipping (cents) ---
FLAT_SHIPPING_CENTS=695
FREE_SHIPPING_THRESHOLD_CENTS=4900
SHIP_TO_COUNTRIES=US

# --- email (Resend) ---
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
EMAIL_FROM=
EMAIL_REPLY_TO=
CONTACT_INBOX=
EMAIL_DRY_RUN=off

# --- parent brand / cross-links ---
PARENT_SITE_URL=https://www.quickdrainny.com
BOOKING_URL=https://book.housecallpro.com/book/Quick-Drain-NY/e1b7e1476a2547d485178813287af6dd?v2=true
PHONE_DISPLAY=(631) 888-6200
PHONE_TEL=+16318886200

# --- analytics / search ---
POSTHOG_KEY=
POSTHOG_HOST=https://us.i.posthog.com
GOOGLE_SITE_VERIFICATION=

# --- lifecycle email timing (hours / days) ---
ABANDONED_CART_HOURS=4
REORDER_REMINDER_LEAD_DAYS=5

# --- image pipeline (optional): path to a Chromium binary for scripts/build_images.py; blank = auto-detect
QD_CHROMIUM=
